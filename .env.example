# Local demo settings. Keep demo mode enabled until the API and authentication are ready.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

POSTGRES_DB=subloop
POSTGRES_USER=subloop
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- API (apps/api) ----
# Matches the credentials above; docker compose creates this database.
DATABASE_URL="postgresql://subloop:local-development-only@localhost:5432/subloop?schema=public"

# Generate strong values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Comma separated list of browser origins allowed by CORS
WEB_ORIGINS="http://localhost:3000"
# Base URL used to build password reset links
WEB_APP_URL="http://localhost:3000"

SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
MAIL_FROM="SubLoop <no-reply@subloop.local>"
RESET_TOKEN_TTL_MINUTES="30"

PORT="3001"
NODE_ENV="development"

# ---- Background jobs / billing ----
REDIS_URL="redis://localhost:6379"
# Daily billing run. Defaults to 00:30 UTC.
BILLING_CRON="30 0 * * *"
BILLING_CRON_TZ="UTC"
# Status for invoices created by a billing run (DRAFT | CONFIRMED | PAID).
INVOICE_DEFAULT_STATUS="CONFIRMED"
# Fallback payment terms when a subscription has none.
DEFAULT_PAYMENT_TERMS_DAYS="0"
